# Exemplo de variáveis de ambiente. NÃO coloque valores reais aqui.
# Para rodar localmente, copie este arquivo para ".env.local" e preencha.
# Na Vercel, estes mesmos nomes vão em Settings -> Environment Variables.
#
# Os valores ficam no Supabase: Project Settings -> API.
#   - Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   - anon / public (key)    -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# (a chave "anon" é pública e protegida pelo RLS; mesmo assim, guarde nas
#  variáveis de ambiente, nunca dentro do código.)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
